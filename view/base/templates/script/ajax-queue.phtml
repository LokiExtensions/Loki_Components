<?php
declare(strict_types=1);

/** @version 2.8.2 */

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Config\Config;
use Loki\Components\Factory\ViewModelFactory;
use Loki\Components\Util\ComponentUtil;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelFactory $viewModelFactory */
/** @var Config $config */
/** @var ComponentUtil $componentUtil */

$config = $viewModelFactory->create(Config::class);
$componentUtil = $viewModelFactory->create(ComponentUtil::class);

$initFormKeyCookie = $block->getArea() === 'frontend';
$interval = (int)$block->getInterval();
if ($interval < 10) {
    $interval = 40;
}
?>
<script>
<?php if ($initFormKeyCookie): ?>
    (() => {
        const hasFormKeyCookie = document.cookie.split(';').some(cookie => cookie.trim().startsWith('form_key='));
        if (hasFormKeyCookie) {
            return;
        }

        const formKey = '<?= $escaper->escapeJs($componentUtil->getFormKey()) ?>';
        const secure = window.location.protocol === 'https:' ? '; secure' : '';
        document.cookie = 'form_key=' + encodeURIComponent(formKey) + '; max-age=86400; path=/; samesite=lax' + secure;
    })();
<?php endif; ?>

    const LokiAjaxQueue = {
        requests: [],
        interval: <?= (int)$interval ?>,
        loading: false,
        posting: false,
        activeElementId: false,
        inputTimestamps: {},
        add(component, update) {
            if (component.skipQueue) {
                component.beforePost();
                this.post([{component, update}]);
                return;
            }

            this.requests.push({
                component,
                update,
            });

            if (component.lazyUpdate) {
                if (component.lazyUpdateTimeout > 0) {
                    setTimeout(async () => {
                        component.lazyUpdate = false;
                    }, component.lazyUpdateTimeout);
                } else {
                    component.lazyUpdate = false;
                }
            }
        },
        run() {
            document.addEventListener('focusin', (e) => {
                if (['input', 'textarea', 'select'].includes(e.target.tagName.toLowerCase())) {
                    if (e.target.id) {
                        this.activeElementId = e.target.id;
                    }
                } else {
                    this.activeElementId = false;
                }
            });

            document.addEventListener('input', (e) => {
                if (e.target && e.target.id) {
                    this.inputTimestamps[e.target.id] = performance.now();
                }
            }, true);

            setInterval(async () => {
                await this.postQueue();
            }, this.interval);
        },
        setLoading(loading) {
            this.loading = loading;
            document.dispatchEvent(new CustomEvent('loki-components.ajax.loading', {detail: loading}));
        },
        async postQueue() {
            if (this.requests.length === 0 || this.posting) {
                return;
            }

            const requests = this.requests;
            const hasNonLazyUpdate = requests.some(request => request.component.lazyUpdate === false);
            if (false === hasNonLazyUpdate) {
                return;
            }

            requests.forEach(request => {
                request.component.beforePost();
            });

            this.requests = [];

            // Only one request at a time, so responses are applied in order on top of a consistent server state
            this.posting = true;
            try {
                await this.post(requests);
            } finally {
                this.posting = false;
            }
        },
        async post(incomingRequests) {
            this.setLoading(true);
            const postedAt = performance.now();

            const requests = incomingRequests.filter(request => !request.component.skipAjax);
            if (requests.length === 0) {
                this.afterPostSuccess(incomingRequests);
                this.afterPostFinally(incomingRequests);
                return;
            }

            let formKey = MageCookies.get('form_key');
            if (!formKey) {
                formKey = LOKI_FORM_KEY;
            }

            await fetch('<?= $escaper->escapeUrl($componentUtil->getPostUrl(
            )) ?>?form_key=' + encodeURIComponent(formKey) + '&isAjax=true', {
                method: 'POST',
                mode: 'same-origin',
                headers: this.getPostHeaders(),
                body: JSON.stringify(this.buildBody(requests))
            })
                .then(async response => {
                    const formKey = response.headers.get('x-magento-form-key');
                    if (formKey) {
                        MageCookies.set('form_key', formKey);
                    }

                    const body = await response.text();
                    if (response.ok) {
                        return body;
                    }

                    LokiComponentsLogger.error('Fetch error', response);

                    const error = new Error(response.statusText);
                    error.status = response.status;
                    error.body = body;
                    throw error;
                })
                .then(html => {
                    try {
                        const data = JSON.parse(html);
                        if (data) {
                            this.handleJson(data);
                            return;
                        }
                    } catch (e) {
                    }

                    this.updateTargetsAfterPost(requests, html, postedAt);
                    this.afterPostSuccess(incomingRequests);
                })
                .catch(error => {
                    let errorMessage = error.name;
                    if (error.body) {
                        errorMessage = error.body.split(/\r?\n/)[0];
                    }

                    Alpine.store('Message').addErrorMessage(errorMessage);
                })
                .finally(() => {
                    this.afterPostFinally(incomingRequests);
                });
        },
        afterPostSuccess(requests) {
            requests.forEach(request => {
                request.component.afterPostSuccess();
            });
        },
        afterPostFinally(requests) {
            requests.forEach(request => {
                request.component.afterPostFinally();
            });

            this.setLoading(false);
            document.dispatchEvent(new CustomEvent('loki-components.ajax.done'));
        },
        getPostHeaders() {
            return {
                'X-Alpine-Request': true,
                'X-Requested-With': 'XMLHttpRequest',
                'Content-Type': 'application/json'
            };
        },
        buildBody(requests) {
            const componentData = JSON.parse('<?= /* @noEscape */ json_encode(
                $componentUtil->getComponentUpdateData($block)
            ) ?>');

            return {
                ...componentData,
                updates: this.getUpdates(requests),
                targets: this.getTargets(requests),
                signature: <?= /* @noEscape */ json_encode(
                    $componentUtil->getSignature($block)
                ) ?>
            };
        },
        handleJson(data) {
            if (data.error) {
                LokiComponentsLogger.error(data.error);
                Alpine.store('Message').addErrorMessage(data.error);
            }

            if (data.redirect) {
                document.location.assign(data.redirect);
            }
        },
        getUpdates(requests) {
            const updates = [];
            requests.forEach(request => {
                updates.push({
                    blockName: request.component.blockId,
                    update: request.update,
                });
            });

            return updates;
        },
        getTargets(requests) {
            const targets = [];
            requests.forEach(request => {
                request.component.targets.forEach(target => {
                    targets.push(target);
                })
            });

            return [...new Set(targets)];
        },
        updateTargetsAfterPost(requests, html, postedAt = null) {
            const typedValue = this.getValueTypedDuringPost(postedAt);
            const parser = new DOMParser();
            const ajaxDocument = parser.parseFromString(html, "text/html");

            const messageScript = ajaxDocument.querySelector('script[type="text/x-loki-messages"]');
            if (messageScript) {
                const messages = JSON.parse(messageScript.innerHTML);
                messages.forEach((message) => {
                    Alpine.store('Message').addMessage(message.type, message.text);
                });
            }

            this.getTargets(requests).forEach(target => {
                const targetElement = document.getElementById(target);
                const newTargetElement = ajaxDocument.getElementById(target);

                if (!targetElement || !newTargetElement) {
                    return;
                }

                const targetComponent = Alpine.store('LokiComponents').getComponentByElementId(target);
                if (targetComponent) {
                    targetComponent.destroy();
                }

                Alpine.mutateDom(() => {
                    Alpine.destroyTree(targetElement);
                    LokiHtmlReplacer.replace(targetElement, newTargetElement);
                    Alpine.initTree(targetElement);
                });
            });

            if (typedValue && this.restoreTypedValue(typedValue)) {
                return;
            }

            if (this.activeElementId) {
                const activeElement = document.getElementById(this.activeElementId);
                if (activeElement) {
                    activeElement.focus();
                    try {
                        activeElement.selectionStart = activeElement.selectionEnd = activeElement.value.length;
                    } catch (e) {
                    }
                }
            }
        },
        getValueTypedDuringPost(postedAt) {
            if (postedAt === null) {
                return null;
            }

            const element = document.activeElement;
            if (!element || !element.id || !['input', 'textarea'].includes(element.tagName.toLowerCase())) {
                return null;
            }

            const lastInput = this.inputTimestamps[element.id];
            if (!lastInput || lastInput < postedAt) {
                return null;
            }

            let selectionStart = null;
            let selectionEnd = null;
            try {
                selectionStart = element.selectionStart;
                selectionEnd = element.selectionEnd;
            } catch (e) {
            }

            return {id: element.id, value: element.value, selectionStart, selectionEnd};
        },
        restoreTypedValue(typedValue) {
            const element = document.getElementById(typedValue.id);
            if (!element) {
                return false;
            }

            if (element.value !== typedValue.value) {
                element.value = typedValue.value;
                element.dispatchEvent(new Event('input', {bubbles: true}));

                // The restored value was not typed into this (new) element, so the browser will not fire a change
                let changed = false;
                element.addEventListener('change', () => changed = true, {once: true});
                element.addEventListener('blur', () => {
                    if (!changed) {
                        element.dispatchEvent(new Event('change', {bubbles: true}));
                    }
                }, {once: true});
            }

            element.focus();
            try {
                if (typedValue.selectionStart !== null) {
                    element.setSelectionRange(typedValue.selectionStart, typedValue.selectionEnd);
                }
            } catch (e) {
            }

            return true;
        }
    };

    LokiAjaxQueue.run();
</script>
