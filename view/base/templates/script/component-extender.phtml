<?php
declare(strict_types=1);


use Loki\Components\Util\Block\ChildRenderer;
use Magento\Framework\View\Element\Template;

/** @version 2.9.0 */
/** @var Template $block */
/** @var ChildRenderer $childRenderer */

?>
<script>
    const LokiComponentExtender = {
        extensions: {},
        extend(componentNames, extensionId, mixin, append = true) {
            const callback = typeof mixin === 'function' ? mixin : () => mixin;
            [].concat(componentNames).forEach(componentName => {
                this.extensions[componentName] = this.extensions[componentName] || {};
                this.extensions[componentName][extensionId] = {callback, append};
            });
        },
        add(extensionId, extenderFunction, append = false) {
            this.extend('*', extensionId, extenderFunction, append);
        },
        addMixin(extensionId, componentName, mixin, append = false) {
            this.extend(componentName, extensionId, mixin, append);
        },
        remove(componentName, extensionId = null) {
            if (extensionId === null) {
                delete this.extensions[componentName];
                return;
            }

            if (this.extensions[componentName]) {
                delete this.extensions[componentName][extensionId];
            }
        },
        getExtensions(componentName) {
            return [
                ...Object.values(this.extensions['*'] || {}),
                ...Object.values(this.extensions[componentName] || {}),
            ];
        },
        merge(target, source) {
            return Object.defineProperties(target, Object.getOwnPropertyDescriptors(source));
        },
        apply(componentName, component, factoryArgs) {
            const extensions = this.getExtensions(componentName);
            if (extensions.length === 0 || typeof component !== 'object' || component === null) {
                return component;
            }

            const parent = this.merge({}, component);
            const componentData = this.merge({}, component);
            const sortedExtensions = [
                ...extensions.filter(extension => !extension.append),
                ...extensions.filter(extension => extension.append),
            ];

            sortedExtensions.forEach(extension => {
                const mixinData = extension.callback(componentName, componentData, factoryArgs, parent);
                if (typeof mixinData !== 'object' || mixinData === null) {
                    return;
                }

                this.merge(componentData, mixinData);
            });

            return componentData;
        }
    };
</script>

<?= /* @noEscape */ $childRenderer->all($block) ?>

<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data = new Proxy(Alpine.data, {
            apply(target, thisArg, args) {
                const [componentName, componentFactory] = args;
                if (typeof componentFactory !== 'function') {
                    return Reflect.apply(target, thisArg, args);
                }

                const extendedFactory = new Proxy(componentFactory, {
                    apply(factory, factoryThis, factoryArgs) {
                        const component = Reflect.apply(factory, factoryThis, factoryArgs);
                        return LokiComponentExtender.apply(componentName, component, factoryArgs);
                    }
                });

                return Reflect.apply(target, thisArg, [componentName, extendedFactory]);
            }
        });
    });
</script>
