<?php
declare(strict_types=1);


use Loki\Components\Util\Block\ChildRenderer;
use Magento\Framework\View\Element\Template;

/** @version 2.7.2 */
/** @var Template $block */
/** @var ChildRenderer $childRenderer */

?>
<script>
    const LokiComponentExtender = {
        extensions: {},
        add(extensionId, extenderFunction, append = false) {
            this.extensions[extensionId] = {extenderFunction, append};
        },
        addMixin(extensionId, matchComponentName, mixin, append = false) {
            this.add(extensionId, (componentName, componentData) => {
                if (matchComponentName !== componentName) {
                    return {};
                }

                return typeof mixin === 'function' ? mixin(componentData) : mixin;
            }, append);
        }
    };
</script>

<?= /* @noEscape */ $childRenderer->all($block) ?>

<script>
    document.addEventListener('alpine:init', () => {
        const originalAlpineData = Alpine.data;

        Alpine.data = (componentName, componentFactory) => {
            let mixinData = {};
            Object.values(LokiComponentExtender.extensions).forEach(extension => {
                if (extension.append) {
                    return;
                }

                const currentMixinData = extension.extenderFunction(componentName);
                if (typeof currentMixinData !== 'object') {
                    return;
                }

                mixinData = Object.assign(mixinData, currentMixinData);
            });

            const hasMixinData = Object.values(mixinData).length > 0;
            const hasAppendData = Object.values(LokiComponentExtender.extensions)
                .some(extension => extension.append);

            if (!hasMixinData && !hasAppendData) {
                return originalAlpineData(componentName, componentFactory);
            }

            const wrapped = (...args) => {
                const base = componentFactory(...args);
                const componentData = hasMixinData ? Object.assign({}, base, mixinData) : base;

                let appendData = {};
                Object.values(LokiComponentExtender.extensions).forEach(extension => {
                    if (!extension.append) {
                        return;
                    }

                    const currentAppendData = extension.extenderFunction(
                        componentName,
                        Object.assign({}, componentData, appendData)
                    );

                    if (typeof currentAppendData !== 'object') {
                        return;
                    }

                    appendData = Object.assign(appendData, currentAppendData);
                });

                if (Object.values(appendData).length < 1) {
                    return componentData;
                }

                return Object.assign({}, componentData, appendData);
            };

            return originalAlpineData(componentName, wrapped);
        };
    });
</script>

