<?php declare(strict_types=1);

/** @version 2.10.2 */

use Loki\Components\Util\ComponentUtil;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Loki\Components\Config\Config;
use Loki\Components\Factory\ViewModelFactory;

/** @var Template $block */
/** @var ViewModelFactory $viewModelFactory */
/** @var Config $config */
/** @var ComponentUtil $componentUtil */
/** @var Escaper $escaper */

$config = $viewModelFactory->create(Config::class);
$componentUtil = $viewModelFactory->create(ComponentUtil::class);
$interval = (int)$block->getPollingInterval();
if ($interval < 1) {
    $interval = $config->getPollingInterval();
}

if ($interval < 500) {
    return;
}

$jsonFlags = JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR;
?>
<script>
    (() => {
        setInterval(() => {
            const formKey = (window.MageCookies && MageCookies.get('form_key')) || window.LOKI_FORM_KEY || '';
            fetch(<?= /* @noEscape */ json_encode($componentUtil->getPollingUrl(), $jsonFlags) ?> + '?isAjax=true', {
                method: 'POST',
                mode: 'same-origin',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'X-Magento-Form-Key': formKey,
                    'Content-Type': 'application/json'
                },
                body: '{}',
            })
                .then(response => {
                    if (response.ok) {
                        return response.text()
                    }

                    LokiComponentsLogger.error('Fetch error', response);
                    throw new Error(response.statusText);
                })
                .then(html => {
                    try {
                        const data = JSON.parse(html);
                        if (data && typeof data === 'object') {
                            const dataParts = Array.isArray(data) ? data : Object.values(data);
                            dataParts.forEach(dataPart => {
                                if (!dataPart || typeof dataPart !== 'object') {
                                    return;
                                }

                                if (dataPart.message) {
                                    const messageType = dataPart.messageType ?? 'notice';
                                    Alpine.store('Message').addMessage(messageType, dataPart.message);
                                }

                                if (dataPart.redirectUrl) {
                                    if (dataPart.redirectMessage) {
                                        Alpine.store('Message').addWarningMessage(dataPart.redirectMessage);
                                    }

                                    const seconds = 3;
                                    setTimeout(() => {
                                        window.location = dataPart.redirectUrl;
                                    }, seconds * 1000)
                                }
                            });
                        }
                    } catch (e) {
                    }
                })
                .catch(error => {
                    Alpine.store('Message').addErrorMessage(error);
                });
        }, <?= (int)$interval ?>);
    })();
</script>
